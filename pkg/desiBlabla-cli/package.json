{
	"name": "desiBlabla-cli",
	"description": "The cli-frontend for desiBlabla",
	"version": "0.1.0",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MYNAME/ref_parameBlabla_mono.git"
	},
	"homepage": "https://MYNAME.github.io/ref_parameBlabla_mono/",
	"author": "MYNAME",
	"license": "ISC",
	"keywords": [
		"parametrix",
		"3D",
		"CAD"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/desiBlabla-cli.d.ts",
			"default": "./dist/desiBlabla-cli.js"
		}
	},
	"bin": "./dist/desiBlabla-cli.js",
	"files": [
		"dist/",
		"!dist/**/*.d.ts",
		"!dist/**/*.map",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"tsdown": {
		"entry": [
			"src/desiBlabla-cli.ts"
		],
		"format": "esm",
		"target": "esnext",
		"fixedExtension": false,
		"splitting": false,
		"dts": false,
		"sourcemap": false,
		"clean": true
	},
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"pretty": "prettier --check .",
		"format": "prettier --write .",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test:unit:once": "vitest --run",
		"test:bats": "bats test/test1.bats",
		"ci": "run-s check build pretty lint test:unit:once test:bats",
		"run": "dist/desiBlabla-cli.js",
		"clean": "rimraf build dist node_modules"
	},
	"dependencies": {
		"desiBlabla": "^0.1.0",
		"geomcli": "^1.0.42",
		"geometrix": "^1.0.42"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/eslint__js": "^8.42.3",
		"bats": "^1.13.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"npm-run-all2": "^9.0.3",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"tsdown": "^0.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^4.1.11"
	}
}
